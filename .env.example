# Mark6 Retail Suite — environment variables (Railway → Variables, or a local .env loaded by your shell)

# Supabase: Project Settings → Database → Connection string → "Session pooler" (IPv4-friendly), URI format.
# Replace [YOUR-PASSWORD] with the database password you set when creating the project.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require

# Or the individual settings instead of DATABASE_URL
# DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
# DB_PORT=5432
# DB_NAME=postgres
# DB_USER=postgres.xxxxxxxxxxxxxxxx
# DB_PASSWORD=
# DB_SCHEMA=public        # schema that holds the Mark6 tables (created if missing)
# DB_SSLMODE=require

APP_TIMEZONE=Asia/Manila
APP_DEBUG=0
APP_TRUST_PROXY=1        # Railway terminates https in front of the container
# APP_BASE_PATH=          # only when the app is served under a sub-folder, e.g. /mark6
